{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "vercel-static",
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "{public,shared,node_modules/simple-icons/icons,node_modules/lucide-static/icons}/**"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
