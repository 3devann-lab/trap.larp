# Required: password for /dashboard
DASHBOARD_PASSWORD=change-me

# Optional
# DASHBOARD_PATH=/dashboard        # move the dashboard somewhere secret, e.g. /my-secret-panel
# DATA_DIR=/data                   # where settings, stats and uploads live (Railway volumes set this automatically)
# SESSION_SECRET=long-random-string # extra secret mixed into login cookies
# SESSION_DAYS=30                  # how long a dashboard login lasts
# MAX_UPLOAD_MB=150                # largest file you can upload
# PUBLIC_URL=https://your.domain   # used for link-embed image URLs (auto-detected on Railway)
# PORT=3000                        # Railway sets this for you
